# ==========================================
# Gemini AI
# ==========================================

# Gemini API key.
# Configure the real value in Google AI Studio / Vercel Environment Variables.
GEMINI_API_KEY="your_gemini_api_key_here"


# ==========================================
# Application
# ==========================================

# The URL where the application is hosted.
# Example for Vercel:
# https://arabdoc.vercel.app
APP_URL="https://your-app-url.example"


# ==========================================
# Supabase
# ==========================================

# Your Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase publishable key.
# Safe to expose to the browser when using Supabase's intended publishable-key model.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# Supabase service role key.
# NEVER expose this in frontend code or commit a real value to GitHub.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Application JWT secret.
# Generate a strong random value for the deployed environment.
JWT_SECRET="your_strong_random_jwt_secret_here"